diff --git a/packages/dockerApi/src/uvmLifecycle.mjs b/packages/dockerApi/src/uvmLifecycle.mjs
new file mode 100644
index 0000000..603ddaf
--- /dev/null
+++ b/packages/dockerApi/src/uvmLifecycle.mjs
@@ -0,0 +1,109 @@
+// Opt-in issue19 adapter. Deliberately fail-closed even if the host broker is absent.
+import fs from 'node:fs';
+import net from 'node:net';
+
+export const UVM_PACKAGE = 'uvm.public.dappnode.eth';
+const SOCKET = '/run/uvm-maintenance/dappmanager.sock';
+
+// This build has no stock self-replacement authorization, including dev/bypass.
+export function assertManagerUpdateAllowed(...identifiers) {
+  if (identifiers.some(value => String(value).toLowerCase().replace(/[^a-z0-9]/g, '')
+      .includes('dappmanagerdnpdappnodeeth')))
+    throw new Error('UVM_MANAGER_SELF_UPDATE_FROZEN: qualify a patched successor under host control');
+}
+
+export async function uploadUvmCertificate(container, {toPath, filename, dataUri}, request = requestUvm) {
+  const info = await container.inspect();
+  let protectedScope = false;
+  try {
+    assertUnmanaged(info.Name, info.Config?.Labels?.['dappnode.dnp.dnpName'],
+      ...(info.Mounts || []).map(mount => mount.Name || mount.Source));
+  } catch (error) {
+    if (!String(error.message).includes('UVM_HOST_LIFECYCLE_REQUIRED')) throw error;
+    protectedScope = true;
+  }
+  if (!protectedScope) return false;
+  const directory = '/urbit/control/owner-tls-public/';
+  const target = toPath === directory || toPath === directory.slice(0,-1)
+    ? directory + filename : toPath;
+  const leaf = ['root-ca.pem','server.pem'].find(name => target === directory + name);
+  const match = typeof dataUri === 'string' && dataUri.length <= 88000 &&
+    /^data:[a-zA-Z0-9.+/-]*;base64,([A-Za-z0-9+/]*={0,2})$/.exec(dataUri);
+  if (!leaf || !match || !/^[a-f0-9]{64}$/.test(info.Id || ''))
+    throw new Error('UVM_PUBLIC_CERTIFICATE_REQUIRED');
+  const raw = Buffer.from(match[1], 'base64');
+  if (!raw.length || raw.length > 65536 || raw.toString('base64') !== match[1])
+    throw new Error('UVM_PUBLIC_CERTIFICATE_REQUIRED');
+  await request({package: UVM_PACKAGE, operation:'certificate', container:info.Id,
+    filename:leaf, content:match[1]});
+  return true;
+}
+
+export function assertUnmanaged(...identifiers) {
+  assertManagerUpdateAllowed(...identifiers);
+  if (identifiers.some(value => String(value).toLowerCase().replace(/[^a-z0-9]/g, '')
+      .includes('uvmpublicdappnodeeth'))) {
+    throw new Error('UVM_HOST_LIFECYCLE_REQUIRED: preserve storage; no stock fallback or rollback');
+  }
+}
+
+export function assertUnmanagedCompose(composePath) {
+  assertUnmanaged(composePath, fs.readFileSync(composePath, 'utf8'));
+}
+
+export async function assertUnmanagedContainer(container) {
+  const info = await container.inspect();
+  assertUnmanaged(info.Name, info.Config?.Labels?.['dappnode.dnp.dnpName'],
+    ...(info.Mounts || []).map(mount => mount.Name || mount.Source));
+}
+
+export async function assertUnmanagedVolume(volume) {
+  const info = await volume.inspect();
+  assertUnmanaged(info.Name, ...Object.values(info.Labels || {}));
+}
+
+export function activateUvm(compose) {
+  return requestUvm({package: UVM_PACKAGE, operation: 'activate', compose});
+}
+
+export function recoverUvm(compose) {
+  return requestUvm({package: UVM_PACKAGE, operation: 'recover', compose});
+}
+
+// Transport injection is only a test seam. Production always uses the fixed
+// root-only host socket; callers cannot supply a path, command or authority.
+export function requestUvm(request, connect = () => net.createConnection(SOCKET)) {
+  return new Promise((resolve, reject) => {
+    const socket = connect();
+    let response = '';
+    const fail = () => {
+      socket.destroy();
+      reject(new Error('UVM_HOST_LIFECYCLE_UNCERTAIN: preserve state; no stock fallback or rollback'));
+    };
+    socket.setTimeout(610000, fail);
+    socket.on('error', fail);
+    socket.on('connect', () => socket.write(JSON.stringify(request) + '\n'));
+    socket.on('data', data => {
+      response += data.toString('utf8');
+      if (Buffer.byteLength(response) > 1024) return fail();
+      if (!response.endsWith('\n')) return;
+      try {
+        const result = JSON.parse(response);
+        const valid = request.operation === 'certificate'
+          ? result.state === 'CERTIFICATE_STORED' && result.container === request.container &&
+            result.filename === request.filename && Object.keys(result).length === 4
+          : request.operation === 'recover'
+          ? result.state === 'RECOVERED_STOPPED' && Object.keys(result).length === 2
+          : request.operation === 'activate' && result.state === 'ACTIVE' &&
+            typeof result.container === 'string' && /^[a-f0-9]{64}$/.test(result.container) &&
+            Object.keys(result).length === 3;
+        if (result.ok !== true || !valid) return fail();
+        socket.end();
+        resolve(result);
+      } catch { fail(); }
+    });
+    socket.on('end', () => {
+      if (!response.endsWith('\n')) fail();
+    });
+  });
+}
