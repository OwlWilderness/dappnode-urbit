FROM alpine@sha256:d56c381f961d307a21b3ca004cf1e3910f106644aefb1f43e654c8a56c4fd395 AS vere-owned-b04
# Source-only preparation. Exact context ELF is deliberately NOT staged yet.
# No download/fallback or target execution. Official historical lock is retained.
COPY --chown=0:0 build/owned-b04/urbit /out/urbit
RUN test "$(wc -c < /out/urbit)" = 42467624 \
    && echo 'f2eba68682650ab6d9712017781612f4dbc3c01411c1ba5c7c4ecbb0f186b6b5  /out/urbit' | sha256sum -c - \
    && chmod 0555 /out/urbit

FROM alpine@sha256:d56c381f961d307a21b3ca004cf1e3910f106644aefb1f43e654c8a56c4fd395
# Preserve every runtime version. The current index omits Python 3.14.8-r0,
# Download with normal CA/hostname validation; reject redirects, retain APK trust.
RUN apk add --no-cache --virtual .python-fetch curl \
    && curl --disable --fail --show-error --silent --location --max-redirs 0 \
    --proto =https --proto-redir =https --connect-timeout 15 \
    --max-time 60 --max-filesize 16777216 \
    --output /tmp/python3-3.14.8-r0.apk \
    https://dl-cdn.alpinelinux.org/alpine/v3.24/main/x86_64/python3-3.14.8-r0.apk \
    && apk add --no-cache zlib=1.3.2-r1 openssl=3.5.9-r0 nginx=1.30.6-r0 \
    /tmp/python3-3.14.8-r0.apk \
    && apk info --exists python3=3.14.8-r0 \
    && test "$(python3 --version)" = 'Python 3.14.8' \
    && python3 --version \
    && apk del .python-fetch \
    && rm /tmp/python3-3.14.8-r0.apk
RUN addgroup -g 10000 urbit \
    && adduser -D -H -u 10000 -G urbit urbit \
    && mkdir -p /opt/importer/web /urbit/pier /urbit/uploads /urbit/control \
    && chown -R 10000:10000 /urbit \
    && chmod 0700 /urbit /urbit/pier /urbit/uploads /urbit/control
LABEL io.uvm.candidate="issue3-owned-20261030-b04" io.uvm.distribution-cleared="false"
COPY --from=vere-owned-b04 /out/urbit /bin/urbit
COPY --chown=0:0 build/vere-owned-b04.json /opt/importer/vere-owned-b04.json
COPY --chown=0:0 build/runtime-b04.py /opt/importer/runtime.py
COPY --chown=0:0 tools/browser-importer/managed_service.py tools/browser-importer/importer.py tools/browser-importer/archive.py tools/browser-importer/enrollment.py tools/browser-importer/backend_tls.py tools/browser-importer/server.py /opt/importer/
COPY --chown=0:0 tools/browser-importer/owner_tls.py tools/browser-importer/package_service.py tools/browser-importer/public_ingress.py /opt/importer/
COPY --chown=0:0 tools/browser-importer/web/index.html tools/browser-importer/web/style.css tools/browser-importer/web/app.mjs tools/browser-importer/web/enroll.html tools/browser-importer/web/enroll.mjs /opt/importer/web/
COPY --chown=0:0 build/volume_guard.py /opt/importer/volume_guard.py
COPY --chown=0:0 build/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY --chown=0:0 THIRD_PARTY/ /usr/share/doc/uvm/THIRD_PARTY/
COPY --chown=0:0 LICENSE.md /usr/share/doc/uvm/LICENSE.md
COPY --chown=0:0 LICENSES/GPL-3.0-only.txt /usr/share/doc/uvm/LICENSES/GPL-3.0-only.txt
COPY --chown=0:0 docs/artwork.md docs/distribution-review.md docs/notice-packaging.md /usr/share/doc/uvm/docs/
COPY --chown=0:0 docs/license-preparation/texts/GPL-2.0.txt docs/license-preparation/texts/GPL-3.0.txt docs/license-preparation/texts/LGPL-2.1.txt docs/license-preparation/texts/LGPL-3.0.txt docs/license-preparation/texts/OpenSSL-3.5.9-LICENSE.txt docs/license-preparation/texts/Vere-MIT.txt docs/license-preparation/texts/avahi-source-header.txt docs/license-preparation/texts/avahi-utf8-header.txt docs/license-preparation/texts/curl-8.23.0-COPYING.txt docs/license-preparation/texts/dbus-COPYING.txt docs/license-preparation/texts/gmp-README.txt docs/license-preparation/texts/sigsegv-README.txt docs/license-preparation/texts/sigsegv-runtime-header.txt docs/license-preparation/texts/urcrypt-MIT.txt /usr/share/doc/uvm/docs/license-preparation/texts/
COPY --chown=0:0 build/notice-files.json /usr/share/doc/uvm/notice-files.json
RUN chmod -R a=rX /usr/share/doc/uvm
USER 10000:10000
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 8443/tcp
EXPOSE 34343/udp
VOLUME /urbit
WORKDIR /opt/importer
ENTRYPOINT ["sh", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["--pier-root", "/urbit/pier", "--uploads-root", "/urbit/uploads", "--control-root", "/urbit/control", "--password-hash-file", "/urbit/control/auth.json"]
